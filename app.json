{
  "expo": {
    "name": "ALI2026",
    "slug": "ali2026",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/appstore.png",
    "scheme": "ali2026",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cjtaylormade.ali2026",
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "slido",
          "completeanatomy",
          "imaios"
        ],
        "RVApiKey": "NOT_USED",
        "RVProjectId": "NOT_USED",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.cjtaylormade.ali2026",
      "predictiveBackGestureEnabled": false,
      "screenOrientation": "landscape"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for QR scanning and AR features.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for video recording.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "@reactvision/react-viro",
        {
          "android": {
            "xRMode": "AR"
          },
          "ios": {
            "cameraUsagePermission": "Allow $(PRODUCT_NAME) to use your camera for AR experiences",
            "microphoneUsagePermission": "Allow $(PRODUCT_NAME) to use your microphone for AR experiences",
            "photosPermission": "Allow $(PRODUCT_NAME) to access your photos for AR experiences",
            "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos to your library during AR experiences"
          }
        }
      ],
      "expo-asset",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "assetBundlePatterns": [
      "assets/models/*",
      "assets/images/*"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "be29515e-56eb-4205-86da-99a9684feaa0"
      }
    },
    "owner": "cjtaylormade"
  }
}
